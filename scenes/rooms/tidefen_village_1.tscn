[node name="Netter" parent="Villagers" instance=ExtResource("20_villager")]
position = Vector2(112, 122)
speaker = "NETTER"
lines = PackedStringArray("My father fished the deep water, before the lights.", "They glow beneath the waves. Pretty, till they bite.", "That old well drops into the dark. No climbing back.")
sheet = ExtResource("21_netter")

[node name="KnotWeaver" parent="Villagers" instance=ExtResource("20_villager")]
position = Vector2(216, 64)
speaker = "KNOT-WEAVER"
lines = PackedStringArray("Every Tidefen child learns the memory-knot.", "One knot for each name you mean to keep.", "The storms strip names. Knots hold them.")
sheet = ExtResource("22_weaver")

[node name="BellKeeper" parent="Villagers" instance=ExtResource("20_villager")]
position = Vector2(488, 112)
speaker = "BELL-KEEPER"
lines = PackedStringArray("I keep the bell. It tolls the curfew.", "When it rings, everyone comes in off the water.", "Nothing good is out there after dark.")
sheet = ExtResource("23_keeper")

[node name="Fisher" parent="Villagers" instance=ExtResource("20_villager")]
position = Vector2(872, 80)
speaker = "FISHER"
lines = PackedStringArray("We keep Bombs for the rocks, not the fish.", "Take what you need from the crate.", "A Bomb would crack the stone in the sea cave.")
sheet = ExtResource("24_fisher")

